# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ── Gemini / Google AI ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ.Ab8RN6IaGrpmUHDxKnBLAbtxwGIxQZGY9gjWW8i3D9OUZGzu3g

# ── Google Cloud Platform ─────────────────────────────────────────────────────
# Your GCP project ID (e.g. my-hazela-project-123)
GOOGLE_CLOUD_PROJECT=

# Absolute path to your Firestore service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Firestore database ID — usually "(default)"
FIRESTORE_DATABASE_ID=(default)

# ── Pub/Sub (Person 4 integration — optional until Day 4) ─────────────────────
# Topic name for async status check triggers
PUBSUB_TOPIC=hazela-status-check

# ── CORS (comma-separated allowed origins for prod) ───────────────────────────
# Leave blank in dev to allow all origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Voice / IVR (Person 3 — kept here for shared reference) ──────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Document Processing (Person 4 — kept here for shared reference) ───────────
DOCUMENT_BUCKET_NAME=

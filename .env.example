[TEMPLATE]
# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# ── Gemini / Google AI ────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Primary Gemini model (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Comma-separated fallback Gemini models (tried on 429/quota errors)
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# ── Grok / xAI (external fallback — used only when all Gemini models fail) ──
# Get from: https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-3-mini
ENABLE_GROK_FALLBACK=false

# ── Google Cloud Platform ─────────────────────────────────────────────────────
# Your GCP project ID (e.g. my-hazela-project-123)
GOOGLE_CLOUD_PROJECT=

# Absolute path to your Firestore service-account JSON key
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Agent Core Settings
OPENAI_API_KEY=placeholder-openai-api-key
AGENT_MODEL_NAME=gpt-4-turbo

# Voice/IVR Settings
TWILIO_ACCOUNT_SID=placeholder-twilio-sid
TWILIO_AUTH_TOKEN=placeholder-twilio-token
TWILIO_PHONE_NUMBER=placeholder-twilio-phone

# Document Processing & Status Jobs
DOCUMENT_BUCKET_NAME=placeholder-doc-bucket
CRON_JOB_INTERVAL_SECONDS=300

# ── Data.gov.in (for scheme ingestion) ──────────────────────────────────────
# Get from: https://data.gov.in/portal/primary-resource
DATA_GOV_API_KEY=

# ── Frontend Integration ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend env (set in frontend/.env)
# NEXT_PUBLIC_API_URL=http://localhost:8000

GEMINI_API_KEY_HZ=your_gemini_api_key_here
